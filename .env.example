# --- Neon Postgres -----------------------------------------------------
# Pooled connection (hostname contains "-pooler"). Used by the app at runtime.
DATABASE_URL=
# DIRECT connection (no "-pooler"). Used ONLY by drizzle-kit migrations.
# Running migrations over the pooled URL fails with errors that never mention
# pooling, so these two are not interchangeable.
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# --- Admin auth --------------------------------------------------------
# The admin password is never stored, only its scrypt hash. Generate one with:
#   npm run admin:hash -- '<password>'
# and paste the whole ADMIN_PASSWORD_HASH=... line it prints.
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 24
# Must be at least 32 characters. Rotating it logs out every session, which is
# the remote logout.
SESSION_SECRET=

# --- Vercel Blob -------------------------------------------------------
# All three are added by Vercel when a PUBLIC Blob store is connected to the
# project, then fetched with `vercel env pull`. A store's access mode is fixed
# at creation: a private store 403s every image on the public site.
#
# Uploads use the presigned flow (handleUploadPresigned), which accepts OIDC.
# The older handleUpload requires a static BLOB_READ_WRITE_TOKEN, which
# OIDC-first stores no longer issue.
BLOB_STORE_ID=
# Short-lived and rotated by Vercel. Locally it expires after 12 hours, after
# which the SDK refreshes it from your Vercel CLI credentials.
VERCEL_OIDC_TOKEN=
# Verifies the Ed25519 signature on the upload-completed webhook.
BLOB_WEBHOOK_PUBLIC_KEY=
